{
  "name": "fin-law-mcp",
  "version": "0.1.0",
  "description": "재무·회계·세무·자금 특화 한국 법령 MCP 서버",
  "type": "module",
  "bin": {
    "fin-law-mcp": "build/index.js"
  },
  "main": "build/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint:dead": "knip",
    "lint:dead:all": "knip --include exports,nsExports,types,nsTypes",
    "test": "vitest run",
    "test:live": "vitest run --config vitest.live.config.ts",
    "prepack": "npm run build",
    "start": "node build/index.js"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "license": "MIT",
  "author": "dolseom",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dolseom/fin-law-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/dolseom/fin-law-mcp/issues"
  },
  "homepage": "https://github.com/dolseom/fin-law-mcp#readme",
  "files": [
    "build",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "keywords": [
    "mcp",
    "korean-law",
    "tax",
    "finance",
    "accounting",
    "법제처",
    "세법"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@xmldom/xmldom": "^0.9.12",
    "dotenv": "^17.4.2",
    "kordoc": "^4.9.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "knip": "^6.34.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
